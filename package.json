{
  "name": "carambar",
  "version": "1.0.0",
  "description": "Node.js app with Express, Sequelize, SQLite, and TypeScript",
  "main": "dist/server.ts",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/winston": "^2.4.4",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
